# suckless 编译生成的目标文件
*.o

# 本仓库内三个项目的本地编译产物
/suckless/dwm/dwm
/suckless/st/st
/suckless/dmenu/dmenu
/suckless/dmenu/stest

# suckless 由唯一配置源 config.def.h 生成的构建配置
/suckless/dwm/config.h
/suckless/st/config.h
/suckless/dmenu/config.h

# suckless 的打包产物
/suckless/dwm/*.tar.gz
/suckless/st/*.tar.gz
/suckless/dmenu/*.tar.gz

# 本地功能开发 worktree
/.worktrees/

# Neovim 在当前目录生成的本地日志
/.nvimlog
