#!/bin/sh

# 设置显示器布局。外接屏始终作为主屏，参数决定它位于笔记本屏的左侧还是右侧。
monitor_position=${1:-left}
"$HOME/workspace/personal/debian-desktop/x11/setup-monitors.sh" "$monitor_position" || exit $?

# 启动 X11 会话前先确保本机代理可用。
# start.sh 自己会处理“已在运行”的情况；如果代理临时失败，也不阻塞桌面启动。
if [ -x "$HOME/workspace/personal/debian-desktop/mihomo/start.sh" ]; then
    "$HOME/workspace/personal/debian-desktop/mihomo/start.sh" >/dev/null 2>&1 || true
fi

# 让 dwm 及其启动的应用默认使用本机 mihomo 代理。
export http_proxy="http://127.0.0.1:7890"
export https_proxy="http://127.0.0.1:7890"
export HTTP_PROXY="http://127.0.0.1:7890"
export HTTPS_PROXY="http://127.0.0.1:7890"
export all_proxy="socks5://127.0.0.1:7890"
export ALL_PROXY="socks5://127.0.0.1:7890"
export no_proxy="127.0.0.1,localhost,::1"
export NO_PROXY="127.0.0.1,localhost,::1"

# 最小 startx 会话里通常没有桌面环境代为初始化 D-Bus，会影响输入法和配置工具。
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-launch >/dev/null 2>&1; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# 告诉 D-Bus 和 systemd 用户服务当前是 DWM X11 会话，确保 portal 等
# 后台服务能够连接 X11 显示。
export XDG_CURRENT_DESKTOP="dwm"
export XDG_SESSION_DESKTOP="dwm"
export XDG_SESSION_TYPE="x11"

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        DISPLAY \
        XAUTHORITY \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE
fi

# 显式导出输入法环境变量，确保终端、浏览器和 GTK/Qt 应用都能调起 fcitx5。
export XMODIFIERS="@im=fcitx"
export GTK_IM_MODULE="fcitx"
export QT_IM_MODULE="fcitx"
export SDL_IM_MODULE="fcitx"

# fcitx5 已运行时跳过；启动失败也不阻塞 dwm 会话。
if command -v fcitx5 >/dev/null 2>&1; then
    pgrep -u "$USER" -x fcitx5 >/dev/null 2>&1 || fcitx5 -d >/dev/null 2>&1 || true
fi

# 设置桌面壁纸。脚本执行完成后 feh 不需要常驻。
"$HOME/workspace/personal/debian-desktop/wallpapers/set-wallpaper.sh"

# 启动 Picom 合成器，提供透明、模糊、阴影和窗口动画效果。
# launch.sh 会先结束旧进程，避免重复启动多个 Picom 实例。
"$HOME/workspace/personal/debian-desktop/picom/launch.sh"

# 用户自行提供 Xresources 时才载入；仓库不维护空置的 Xresources。
if [ -r "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1; then
    xrdb -merge "$HOME/.Xresources"
fi

# 由 startx 启动 dwm。
# 优先使用当前用户下的编译结果，避免依赖系统目录里的旧版本。
# exec 让 dwm 接管当前 X11 会话；退出 dwm 时，X11 会话随之结束。
exec "$HOME/.local/bin/dwm"
